rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'provider', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'provider', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() <= 256
        && data.displayName is string
        && data.displayName.size() <= 120
        && data.provider is string
        && data.provider in ['password', 'google.com', 'other']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidHistoryItem(data, userId) {
      return data.keys().hasAll([
          'uid', 'audioFileName', 'audioDurationSec', 'audioSampleRate',
          'templateId', 'templateName', 'aspectRatio', 'resolution',
          'fps', 'quality', 'outputWidth', 'outputHeight',
          'outputSizeBytes', 'codecLabel', 'offsetX', 'offsetY',
          'primaryColor', 'secondaryColor', 'accentColor', 'backgroundType',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'uid', 'audioFileName', 'audioDurationSec', 'audioSampleRate',
          'templateId', 'templateName', 'aspectRatio', 'resolution',
          'fps', 'quality', 'outputWidth', 'outputHeight',
          'outputSizeBytes', 'codecLabel', 'offsetX', 'offsetY',
          'primaryColor', 'secondaryColor', 'accentColor', 'backgroundType',
          'createdAt'
        ])
        && data.uid is string
        && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.audioFileName is string
        && data.audioFileName.size() >= 1 && data.audioFileName.size() <= 200
        && data.audioDurationSec is number
        && data.audioDurationSec >= 0 && data.audioDurationSec <= 86400
        && data.audioSampleRate is number
        && data.audioSampleRate >= 8000 && data.audioSampleRate <= 384000
        && data.templateId is string
        && data.templateId.size() >= 1 && data.templateId.size() <= 64
        && data.templateName is string
        && data.templateName.size() >= 1 && data.templateName.size() <= 80
        && data.aspectRatio is string
        && data.aspectRatio in ['9:16', '16:9', '1:1', '4:5', '4:3', '3:4', '21:9', '2:1']
        && data.resolution is string
        && data.resolution in ['1080p', '2k', '4k']
        && data.fps is number
        && data.fps in [24, 30, 50, 60]
        && data.quality is string
        && data.quality in ['standard', 'high', 'ultra']
        && data.outputWidth is number
        && data.outputWidth >= 100 && data.outputWidth <= 8192
        && data.outputHeight is number
        && data.outputHeight >= 100 && data.outputHeight <= 8192
        && data.outputSizeBytes is number
        && data.outputSizeBytes >= 0 && data.outputSizeBytes <= 10737418240
        && data.codecLabel is string
        && data.codecLabel.size() >= 1 && data.codecLabel.size() <= 80
        && data.offsetX is number
        && data.offsetX >= -50 && data.offsetX <= 50
        && data.offsetY is number
        && data.offsetY >= -50 && data.offsetY <= 50
        && data.primaryColor is string
        && data.primaryColor.size() >= 4 && data.primaryColor.size() <= 20
        && data.secondaryColor is string
        && data.secondaryColor.size() >= 4 && data.secondaryColor.size() <= 20
        && data.accentColor is string
        && data.accentColor.size() >= 4 && data.accentColor.size() <= 20
        && data.backgroundType is string
        && data.backgroundType in ['black', 'solid', 'gradient', 'preset-image', 'custom-image']
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'provider', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(userId) && isOwner(userId);

      match /history/{historyId} {
        allow get: if isSignedIn()
          && isValidId(userId)
          && isValidId(historyId)
          && isOwner(userId)
          && existing().uid == request.auth.uid;
        allow list: if isSignedIn()
          && isOwner(userId)
          && resource.data.uid == request.auth.uid;
        allow create: if isSignedIn()
          && isValidId(userId)
          && isValidId(historyId)
          && isOwner(userId)
          && isValidHistoryItem(incoming(), userId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if false;
        allow delete: if isSignedIn()
          && isValidId(userId)
          && isValidId(historyId)
          && isOwner(userId)
          && existing().uid == request.auth.uid;
      }
    }
  }
}
